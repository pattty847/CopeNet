# Local CopeNet host settings. Copy this file to `.copenet.env`; that file is
# gitignored and intentionally separate from integration credentials.
#
# Generate a private token once:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
COPNET_TOKEN="replace-with-a-random-token"

# Keep the default launch on loopback. The `copenet-tail` alias overrides this
# with `COPNET_HOST=tailscale` so the same file works for both launch modes.
COPNET_PORT=17123

# SEC asks automated clients to identify a real contact. Put your own value only in the
# gitignored `.copenet.env`; never commit a personal name or email here.
SEC_API_USER_AGENT="CopeNet/0.1 your-email@example.com"

# FRED macro series, search, and ALFRED point-in-time observations.
# Request a free key at https://fred.stlouisfed.org/docs/api/api_key.html.
FRED_API_KEY=""

# Media transcription (MLX Whisper on Apple Silicon; needs `uv sync --extra media`).
# Short names: turbo (default), large-v3, small.en; or any Hugging Face repo id.
# COPNET_WHISPER_MODEL=turbo
# Seconds without transcription work before the model is unloaded from memory.
# COPNET_WHISPER_IDLE_SECONDS=600
