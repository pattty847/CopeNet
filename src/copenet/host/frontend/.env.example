# Optional explicit WebSocket URL for local frontend development.
# Leave unset when the built frontend is served by CopeNet itself.
VITE_COPNET_WS_URL="ws://127.0.0.1:17123/ws"

# Optional token override for local development.
# If omitted, the frontend falls back to window/localStorage/meta or "dev-token".
VITE_COPNET_TOKEN="dev-token"
