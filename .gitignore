.DS_Store
**/.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local tool worktrees
.claude/
.superpowers/
.agents/

# Local scratch outputs
tmp/

# CopeTech-Edgar's runtime cache — SECDataFetcher defaults to the relative path "data/edgar",
# which lands here whenever CopeNet (or a test script) is run from the repo root. Not source,
# never meant to be committed.
data/

# Local documentation
GEMINI.md
docs/codex/CLI_COMMANDS.md
docs/tests/
docs/private/
# Added by code-review-graph
.code-review-graph/
knowledge-cache/
config/knowledge-sources.local.toml
config/*.local.toml
.claire/


# Local credentials and machine-specific configuration. Examples/templates are the only
# environment files that may be committed.
.env*
**/.env*
!.env.example
!**/.env.example
!.env.sample
!**/.env.sample
!.env.template
!**/.env.template
.copenet.env
*.pem
*.key
*.p12
*.pfx
*.jks

# Broker/account-derived data must remain local even when COPNET_HOME points into the repo.
**/webull/token/
**/webull/account.json
**/webull/portfolio.json
**/webull/orders.json
**/webull/*.log*
**/portfolio-export*.csv
**/holdings-export*.csv
**/transactions-export*.csv
**/fills-export*.csv
# Red-team demo scratch output (regenerated by scripts/redteam_demo.py)
docs/redteam-demo/output/

# Red-team demo: agent-generated scratch (restore inbox via git checkout)
docs/redteam-demo/workspace/result.txt
docs/redteam-demo/workspace/shell_ran.txt
